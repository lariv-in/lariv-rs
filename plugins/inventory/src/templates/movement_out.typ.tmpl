{# Minijinja template: output must be valid Typst markup.
   Stock movement out (delivery challan).
   Context:
     Number, Datetime,
     Customer { Name, Address, Gstin, Phone, Email },
     Lines [ { Stock, Qty, Unit, QtyType } ],
     VehicleType, VehicleNumber, EwayBill,
     Driver { Name, Phone, Email },
     CompanyName, CompanyAddress, CompanyPhone, CompanyEmail, CompanyGstin,
     Terms,
     Logo, Signature
   CompanyAddress, Customer.Address, and Terms are Typst markup.
   Function: vnodeImage. #}
#set page(paper: "a4", margin: 1.2cm)
#set text(font: "Liberation Sans", size: 10pt)

{% set company_name = company_name or CompanyName or "" %}
{% set company_address = company_address or CompanyAddress or "" %}
{% set company_phone = company_phone or CompanyPhone or "" %}
{% set company_email = company_email or CompanyEmail or "" %}
{% set company_gstin = company_gstin or CompanyGstin or "" %}
{% set terms_and_conditions = terms_and_conditions or TermsAndConditions or Terms or "" %}
{% set company_logo_vnode_id = company_logo_vnode_id or CompanyLogoVnodeId or Logo or 0 %}
{% set company_signature_vnode_id = company_signature_vnode_id or CompanySignatureVnodeId or Signature or 0 %}
{% set challan_number = ChallanNumber or Number or "" %}
{% set challan_date = Date or Datetime or "" %}
{% set vehicle_no = VehicleNo or VehicleNumber or "" %}
{% set eway_bill = EwayBill or "" %}
{% set customer_gstin = Customer.GSTIN or Customer.Gstin or "" %}

#align(center)[
  #text(size: 14pt, weight: "bold")[DELIVERY CHALLAN]
]

#v(0.6em)
#grid(
  columns: (1fr, auto),
  column-gutter: 1em,
  [
    #text(size: 12pt, weight: "bold")[{{ company_name }}] \
    {{ company_address }} \
    {% if company_phone %}Phone: {{ company_phone }} \ {% endif %}
    {% if company_email %}Email: {{ company_email | replace("@", "\\@") }} \ {% endif %}
    {% if company_gstin %}GSTIN: {{ company_gstin }}{% endif %}
  ],
  [
    {% if company_logo_vnode_id and company_logo_vnode_id != 0 %}
    #image("{{ vnodeImage(company_logo_vnode_id) }}", width: 3.2cm)
    {% endif %}
  ],
)

#v(0.8em)
#table(
  columns: (1fr, 1fr),
  [
    *Delivered to* \
    {% if Customer.Name %}*{{ Customer.Name }}* \ {% endif %}
    {% if Customer.Address %}{{ Customer.Address }} \ {% endif %}
    {% if customer_gstin %}GSTIN: {{ customer_gstin }} \ {% endif %}
    {% if Customer.Phone %}Phone: {{ Customer.Phone }} \ {% endif %}
    {% if Customer.Email %}Email: {{ Customer.Email | replace("@", "\\@") }}{% endif %}
  ],
  [
    *Challan No.:* {{ challan_number }} \
    *Date:* {{ challan_date }} \
    {% if VehicleType %}*Vehicle:* {{ VehicleType }} \ {% endif %}
    {% if vehicle_no %}*Vehicle No.:* {{ vehicle_no }} \ {% endif %}
    {% if eway_bill %}*E-Way Bill:* {{ eway_bill }} \ {% endif %}
    {% if Driver.Name %}*Driver:* {{ Driver.Name }}{% endif %}
  ],
)

#v(0.8em)
#table(
  columns: (auto, 1fr, auto),
  align: (center, left, right),
  [*Sr. No.*], [*Product*], [*Qty*],
  {% for line in Lines %}
  [{{ line.SrNo or loop.index }}], [{{ line.Product or line.Stock }}], [{{ line.Qty }}{% if line.Unit %} {{ line.Unit }}{% endif %}],
  {% endfor %}
)

{% if terms_and_conditions %}
#v(0.8em)
#text(size: 8.5pt)[
  *Terms and conditions* \
  {{ terms_and_conditions }}
]
{% endif %}

#v(1.6em)
#grid(
  columns: (1fr, auto),
  [
    #text(size: 8pt, fill: luma(40))[Goods delivered as above.],
  ],
  [
    {% if company_signature_vnode_id and company_signature_vnode_id != 0 %}
    #align(center)[
      #image("{{ vnodeImage(company_signature_vnode_id) }}", height: 1.6cm) \
      Authorised signatory
    ]
    {% else %}
    #align(center)[
      #v(1.6cm)
      Authorised signatory
    ]
    {% endif %}
  ],
)
